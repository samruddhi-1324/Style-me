# StyleMe Backend Environment Configuration Example
# Keep this file safe to commit; replace placeholders in your private environment only.
# Spring Boot does not load .env automatically; set these in your shell, IDE, or hosting environment.

# Local development: use PostgreSQL. The "local" profile is H2-only.
PORT=8080
SPRING_PROFILES_ACTIVE=local-postgres
LOCAL_DATABASE_URL=jdbc:postgresql://localhost:5432/styleme
LOCAL_DATABASE_USERNAME=postgres
LOCAL_DATABASE_PASSWORD=replace-with-your-local-postgres-password

# Production database on Supabase. For session pooler access, use the host,
# port, database, and username shown in the Supabase Connect dialog.
SUPABASE_DATABASE_URL=jdbc:postgresql://db.<project-ref>.supabase.co:5432/postgres?sslmode=require
SUPABASE_DATABASE_USERNAME=postgres
SUPABASE_DATABASE_PASSWORD=replace-with-your-supabase-database-password
# Select "prod" in the deployment environment (do not use the local profile).
# SPRING_PROFILES_ACTIVE=prod
# CORS_ALLOWED_ORIGINS=https://your-storefront-domain.example
# FRONTEND_URL=https://your-storefront-domain.example
# GOOGLE_OAUTH_ENABLED=true
# CSRF_ENABLED=true
# PORT=8080

# Supabase Storage (configure in the backend deployment environment).
# Keep the service role key server-side only; never use NEXT_PUBLIC_* for it.
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_STORAGE_BUCKET=replace-with-your-storage-bucket
SUPABASE_SERVICE_ROLE_KEY=replace-with-your-supabase-service-role-key

# Security & JWT Configuration
# Generate unique, random secrets of at least 256 bits for each environment.
JWT_SECRET=replace-with-a-unique-random-local-secret-of-at-least-32-characters
JWT_EXPIRATION_MS=86400000

# Google OAuth (backend only; never expose either value to the frontend).
GOOGLE_CLIENT_ID=replace-with-your-google-oauth-client-id
GOOGLE_CLIENT_SECRET=replace-with-your-google-oauth-client-secret

# CORS Allowed Origins (comma-separated)
CORS_ALLOWED_ORIGINS=http://localhost:3000
# Set a separate production JWT_SECRET and CORS_ALLOWED_ORIGINS in the hosting environment.

# Logging & Operational Monitoring
# Set this for production deployments that use file-based logging.
# LOG_FILE_PATH=/var/log/styleme/styleme-backend.log
MANAGEMENT_PORT=8081
