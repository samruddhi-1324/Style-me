# StyleMe Backend Environment Configuration Example
# Copy to .env in your local environment. NEVER commit real credentials to version control.

# Server Configuration
PORT=8080

# Database Configuration (PostgreSQL)
DATABASE_URL=jdbc:postgresql://localhost:5432/styleme
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=postgres

# Security & JWT Configuration
# Generate a secure 256-bit secret key for production environments
JWT_SECRET=your-secure-256-bit-secret-key-placeholder-must-be-at-least-32-chars-long
JWT_EXPIRATION_MS=86400000

# CORS Allowed Origins (comma-separated)
CORS_ALLOWED_ORIGINS=http://localhost:3000,https://style-me-virid.vercel.app

# Google OAuth (backend only; keep actual credentials in the backend process environment).
GOOGLE_CLIENT_ID=replace-with-your-google-oauth-client-id
GOOGLE_CLIENT_SECRET=replace-with-your-google-oauth-client-secret
