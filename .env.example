# StyleMe Eyewear - Environment Configuration Example
# Frontend uses the authoritative Spring Boot backend for catalog, auth, and commerce flows.
# Set NEXT_PUBLIC_API_URL to the local or deployed backend base URL.

NEXT_PUBLIC_API_URL=http://localhost:8080
NEXT_PUBLIC_AUTH_ENABLED=true
NEXT_PUBLIC_SITE_URL=https://styleme-eyewear.vercel.app

# Set NEXT_PUBLIC_AUTH_ENABLED=false in Vercel until the Spring Boot backend is hosted.
