# StyleMe Eyewear - Environment Configuration Example
# Frontend-only settings. Do not put Google client secrets or database credentials here.
# Store OAuth credentials in the backend's private .env file instead.

NEXT_PUBLIC_API_URL=http://localhost:8080
NEXT_PUBLIC_AUTH_ENABLED=true
NEXT_PUBLIC_CSRF_ENABLED=false
NEXT_PUBLIC_SITE_URL=http://localhost:3000
